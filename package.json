{
  "name": "glimmer-ui",
  "version": "0.1.0",
  "description": "Glass-and-glow component classes for the web, with a matching SwiftUI package.",
  "type": "module",
  "style": "css/index.css",
  "exports": {
    ".": {
      "style": "./css/index.css",
      "default": "./css/index.css"
    },
    "./css/*": "./css/*",
    "./fonts/*": "./fonts/*",
    "./glow.js": {
      "types": "./glow.d.ts",
      "default": "./glow.js"
    },
    "./charts.js": {
      "types": "./charts.d.ts",
      "default": "./charts.js"
    },
    "./behaviors.js": {
      "types": "./behaviors.d.ts",
      "default": "./behaviors.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./react.js": {
      "types": "./react.d.ts",
      "default": "./react.js"
    }
  },
  "files": [
    "css",
    "fonts",
    "*.js",
    "*.d.ts",
    "LICENSE"
  ],
  "scripts": {
    "tokens": "node build-tokens.mjs",
    "build": "node build-tokens.mjs && node build-css.mjs",
    "test": "node --test"
  },
  "sideEffects": [
    "*.css",
    "glow.js",
    "charts.js",
    "behaviors.js",
    "react.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huntercash/glimmer-ui.git"
  },
  "bugs": "https://github.com/huntercash/glimmer-ui/issues",
  "homepage": "https://glimmer-ui.com",
  "keywords": [
    "css",
    "ui",
    "components",
    "glass",
    "tailwindcss",
    "charts",
    "swiftui"
  ]
}
